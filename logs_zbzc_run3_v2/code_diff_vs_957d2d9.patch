+        e_data = 1 - (1 - e["DATAeff"][0]) * (1 - e["DATAeff"][1])
+        e_mc = 1 - (1 - e["MCeff"][0]) * (1 - e["MCeff"][1])
+        return np.where(e_mc > 0, e_data / np.where(e_mc > 0, e_mc, 1.0), 1.0)
